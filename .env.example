# Copy to .env.local and fill in. Never commit the real file.
# Next.js loads .env.local automatically for `next dev` and `next start`.

# Turso database. Create one with:
#   turso db create amaliscribe-releases
#   turso db show amaliscribe-releases --url
TURSO_DATABASE_URL=libsql://amaliscribe-releases-<org>.turso.io

# Token for the database above:
#   turso db tokens create amaliscribe-releases
TURSO_AUTH_TOKEN=

# Shared secret CI presents as `Authorization: Bearer <token>` when publishing a
# release. Server-side only — it has no NEXT_PUBLIC_ prefix, so it is never
# included in the client bundle. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CI_RELEASE_TOKEN=

# --- Local development alternatives for TURSO_DATABASE_URL ---
# A local libSQL server (closest to production, works on any runtime):
#   turso dev --db-file local.db
#   TURSO_DATABASE_URL=http://127.0.0.1:8080
#
# A plain local file (no CLI needed, Node runtime only — not edge):
#   TURSO_DATABASE_URL=file:data/releases.db
